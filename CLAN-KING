-- Pestaña Main
local MainTab = Window:CreateTab("🏠 Main", nil)
local MainSection = MainTab:CreateSection("Auto Farm")

local AutoWeight = false
local AutoRebirth = false

-- Option 1: AUTO WEIGHT
MainTab:CreateToggle({
    Name = "🏋️ AUTO WEIGHT",
    CurrentValue = false,
    Flag = "AutoWeight",

    Callback = function(Value)
        AutoWeight = Value
        
        task.spawn(function()
            local player = game:GetService("Players").LocalPlayer
            
            while AutoWeight do
                local character = player.Character
                if character and character:FindFirstChildOfClass("Humanoid") then
                    -- Equipar la pesa
                    local weightTool = player.Backpack:FindFirstChild("Weight") or character:FindFirstChild("Weight")
                    if weightTool then
                        if weightTool.Parent ~= character then
                            character.Humanoid:EquipTool(weightTool)
                        end
                        
                        -- 1. Simular la activación/clic del tool en el personaje
                        weightTool:Activate()
                    end
                    
                    -- 2. Por si el juego requiere disparar su evento específico
                    local muscleEvent = player:FindFirstChild("muscleEvent")
                    if muscleEvent then
                        muscleEvent:FireServer("rep")
                    end
                end
                task.wait(0.05) -- Intervalo rápido para que haga las reps rápido
            end
        end)
    end,
})

-- Option 2: AUTO REBIRTH
MainTab:CreateToggle({
    Name = "🔄 AUTO REBIRTH",
    CurrentValue = false,
    Flag = "AutoRebirth",

    Callback = function(Value)
        AutoRebirth = Value
        
        task.spawn(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            
            while AutoRebirth do
                local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
                if rEvents and rEvents:FindFirstChild("rebirthRemote") then
                    local rebirthRemote = rEvents.rebirthRemote
                    if rebirthRemote:IsA("RemoteFunction") then
                        rebirthRemote:InvokeServer("rebirthRequest")
                    elseif rebirthRemote:IsA("RemoteEvent") then
                        rebirthRemote:FireServer("rebirthRequest")
                    end
                end
                task.wait(0.5)
            end
        end)
    end,
})
