})

-- 🛡️ ANTI AFK MEJORADO
MiscTab:CreateToggle({
    Name = "🛡️ Anti AFK (Mejorado)",
    CurrentValue = false,
    Flag = "AntiAfk",
    Callback = function(Value)
        AntiAfkEnabled = Value
        if AntiAfkEnabled then
            local VirtualUser = game:GetService("VirtualUser")
            AntiAfkConnection = LocalPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:Button2Down(Vector2.new(0, 0), CoreGui.CurrentCamera and CoreGui.CurrentCamera.ViewportSize or Vector2.new(1920, 1080))
                task.wait(0.15)
                VirtualUser:Button2Up(Vector2.new(0, 0), CoreGui.CurrentCamera and CoreGui.CurrentCamera.ViewportSize or Vector2.new(1920, 1080))
            end)
            -- Loop de seguridad cada 4 min
            AntiAfkLoop = task.spawn(function()
                while AntiAfkEnabled do
                    task.wait(240)
                    if not AntiAfkEnabled then return end
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(0,0))
                    end)
                end
            end)
        else
            if AntiAfkConnection then AntiAfkConnection:Disconnect() AntiAfkConnection = nil end
            if AntiAfkLoop then task.cancel(AntiAfkLoop) AntiAfkLoop = nil end
        end
    end,
})

