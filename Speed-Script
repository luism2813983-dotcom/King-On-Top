-- BUCLES GLOBALES
-- ==============================================
RunService.Heartbeat:Connect(function()
    -- Lock Position
    if LockPosEnabled then
        local char = LocalPlayer.Character
        if char and char.PrimaryPart then
            char.PrimaryPart.CFrame = CFrame.new(LockPosition)
        end
    end
    -- Mantener velocidad
    if SpeedEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.WalkSpeed ~= SpeedValue then
            char.Humanoid.WalkSpeed = SpeedValue
        end
    end
    -- AntiLag: desactivar efectos
    if AntiLagEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = false end
                if v:IsA("PointLight") or v:IsA("SpotLight") then v.Enabled = false end
            end
        end
    end
end)

-- Restaurar velocidad al respawnear
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid", 10)
