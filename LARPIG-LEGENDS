local function ApplyCustomBackground(targetCoreGui, imageId, transparency)
    local backgroundImage = Instance.new("ImageLabel")
    backgroundImage.Name = "RayfieldCustomBackground"
    backgroundImage.Size = UDim2.new(1, 0, 1, 0)
    backgroundImage.Position = UDim2.new(0, 0, 0, 0)
    backgroundImage.Image = "rbxassetid://" .. tostring(imageId)
    backgroundImage.BackgroundTransparency = 1
    backgroundImage.ImageTransparency = transparency
    backgroundImage.ScaleType = Enum.ScaleType.Crop
    backgroundImage.ZIndex = -1

    local mainFrame = targetCoreGui:FindFirstChild("Main")
    if mainFrame then
        backgroundImage.Parent = mainFrame
        if mainFrame:IsA("Frame") then
             mainFrame.BackgroundTransparency = 1
        end
    else
        backgroundImage.Parent = targetCoreGui
    end
end

task.spawn(function()
