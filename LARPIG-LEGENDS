-- 🔧 SISTEMA ANTI LAG (UN SOLO BOTÓN)
-- /////////////////////////////////////////////////
local AntiLagEnabled = false

local function ApplyAntiLag()
    local Workspace = game:GetService("Workspace")
    local Lighting = game:GetService("Lighting")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- 🧹 Limpiar restos
    pcall(function()
        task.spawn(function()
            while AntiLagEnabled do
                task.wait(3)
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("BasePart") and (v.Name == "Debris" or v.Name == "Effect" or v.Name == "Particle") then
                        pcall(function() v:Destroy() end)
                    end
                end
            end
        end)
    end)

    -- ✨ Desactivar partículas
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("SmokeEmitter") or v:IsA("Fire") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end
        task.spawn(function()
            while AntiLagEnabled do
                task.wait(1)
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("SmokeEmitter") or v:IsA("Fire") or v:IsA("Sparkles") then
                        v.Enabled = false
                    end
                end
            end
        end)
    end)

    -- 🌑 Sombras y luces
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.Brightness = 1
        Lighting.EnvironmentSpecularScale = 0
        Lighting.EnvironmentDiffuseScale = 0
    end)

    -- 🎨 Calidad gráfica
    pcall(function()
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CastShadow = false
                v.Material = Enum.Material.Plastic
                v.Reflectance = 0
            end
        end
    end)

    -- 🖼️ Renderizado
    pcall(function()
        LocalPlayer:SetAttribute("QualityLevel", 1)
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level1
        settings().Rendering.Mode = Enum.RenderMode.Direct3D
    end)
end

local function DisableAntiLag()
    local Lighting = game:GetService("Lighting")
    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
        Lighting.Brightness = 2
    end)
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level8
    end)
end

