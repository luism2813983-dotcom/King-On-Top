-- 📍 LOCK POSITION
local LockPosition = false
local SavedPosition = nil
local Players = game:GetService("Players")
local player = Players.LocalPlayer

MiscTab:CreateToggle({
    Name = "📍 LOCK POSITION",
    CurrentValue = false,
    Flag = "LockPosition",
    Callback = function(Value)
        LockPosition = Value
        if LockPosition then
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                SavedPosition = player.Character.HumanoidRootPart.Position
                Rayfield:Notify({Title = "📍 Posición Bloqueada", Content = "Posición guardada correctamente!", Duration = 3})
            end
        else
            SavedPosition = nil
            Rayfield:Notify({Title = "📍 Posición Desbloqueada", Content = "Ya puedes moverte libremente", Duration = 3})
        end
    end,
})

task.spawn(function()
    while true do
        task.wait(0.05)
        if LockPosition and SavedPosition then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local hrp = char.HumanoidRootPart
                if (hrp.Position - SavedPosition).Magnitude > 0.5 then
                    hrp.CFrame = CFrame.new(SavedPosition)
                end
            end
        end
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(0.3)
    if LockPosition and SavedPosition then
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(SavedPosition)
            Rayfield:Notify({Title = "📍 Posición Restaurada", Content = "Reapareciste en tu posición!", Duration = 2})
        end
    end
end)
