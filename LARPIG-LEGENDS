    for _, gui in ipairs(coreGui:GetChildren()) do
        if gui.Name == "Rayfield" or (gui:IsA("ScreenGui") and gui:FindFirstChild("Main")) then
            ApplyCustomBackground(gui, 1787967131252, 0.5)
            break
        end
    end
end)

