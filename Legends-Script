-- AUTO WEIGHT
MainTab:CreateToggle({
    Name = "🏋️ AUTO WEIGHT",
    CurrentValue = false,
    Flag = "AutoWeight",
    Callback = function(Value)
        AutoWeight = Value
        task.spawn(function()
            local player = game:GetService("Players").LocalPlayer
            while AutoWeight do
                local char = player.Character
                if char and char:FindFirstChildOfClass("Humanoid") then
                    local tool = player.Backpack:FindFirstChild("Weight") or char:FindFirstChild("Weight")
                    if tool then
                        if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
                        tool:Activate()
                    end
                    local event = player:FindFirstChild("muscleEvent")
                    if event then event:FireServer("rep") end
                end
                task.wait()
            end
        end)
    end,
})

