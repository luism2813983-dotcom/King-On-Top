-- 🐾 Pestaña Pets — Auto Cristal desde CUALQUIER LUGAR 💎
local PetsTab = Window:CreateTab("🐾 Pets", nil)
PetsTab:CreateSection("EGG FARM")

local AutoCrystal = false

PetsTab:CreateToggle({
    Name = "💎 Auto Abrir Cristal (CUALQUIER LUGAR)",
    CurrentValue = false,
    Flag = "AutoCrystal",
    Callback = function(Value)
        AutoCrystal = Value
        task.spawn(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer
            
            local openEvent
            repeat
                local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
                openEvent = rEvents and rEvents:FindFirstChild("openCrystalRemote")
                task.wait(0.1)
            until openEvent or not AutoCrystal
            
            if not openEvent then
                Rayfield:Notify({Title = "❌ Error", Content = "No se encontró el evento de cristales", Duration = 5})
                return
            end

            Rayfield:Notify({Title = "✅ Activado", Content = "Abriendo desde cualquier lugar...", Duration = 3})

            while AutoCrystal do
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then 
                    task.wait(0.5) 
                    continue 
                end

                local crystalPart = nil
                for _, v in pairs(workspace:GetDescendants()) do
                    if v:IsA("BasePart") and v.Name == "Weakness Crystal" then
                        crystalPart = v
                        break
                    end
                end

                if crystalPart then
                    local originalPosition = char.HumanoidRootPart.CFrame
                    char.HumanoidRootPart.CFrame = crystalPart.CFrame + Vector3.new(0, 2, 0)
                    task.wait(0.03)
                    openEvent:InvokeServer("openCrystal", "Weakness Crystal")
                    task.wait(0.03)
                    char.HumanoidRootPart.CFrame = originalPosition
                end

                task.wait(0.5)
            end
        end)
    end,
})

