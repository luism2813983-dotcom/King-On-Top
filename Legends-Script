local MiscTab = Window:CreateTab("⚙️ Misc", nil)
MiscTab:CreateSection("🚀 Rendimiento y Utilidades")

-- 🧹 ANTI LAG
local AntiLag = false
MiscTab:CreateToggle({
    Name = "🧹 Anti Lag",
    CurrentValue = false,
    Flag = "AntiLag",
    Callback = function(Value)
        AntiLag = Value
        task.spawn(function()
            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer
            local Lighting = game:GetService("Lighting")
            local Workspace = game:GetService("Workspace")
            
            if AntiLag then
                Rayfield:Notify({Title = "✅ Anti Lag", Content = "Optimización activada", Duration = 3})
                pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
                pcall(function() Lighting.ShadowSoftness = 0 end)
                pcall(function() Lighting.GlobalShadows = false end)
                pcall(function() Lighting.Ambient = Color3.fromRGB(128,128,128) end)
                
                while AntiLag do
                    task.wait(2)
                    pcall(function()
                        for _, desc in ipairs(Workspace:GetDescendants()) do
                            if not AntiLag then break end
                            if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Fire") or desc:IsA("Smoke") then
                                if not desc.Parent:IsDescendantOf(LocalPlayer.Character) then
                                    desc.Enabled = false
                                end
                            end
                        end
                    end)
                end
            else
                Rayfield:Notify({Title = "🔄 Anti Lag", Content = "Desactivado", Duration = 2})
                pcall(function() Lighting.Technology = Enum.Technology.Forward end)
                pcall(function() Lighting.GlobalShadows = true end)
            end
        end)
    end,
})

