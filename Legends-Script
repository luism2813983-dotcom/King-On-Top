-- 🎯 LOCK POSITION — BLOQUEO DE POSICIÓN
local LockPosition = false
local OriginalPosition = nil
local LockPositionConnection = nil

MiscTab:CreateToggle({
    Name = "🎯 Lock Position",
    CurrentValue = false,
    Flag = "LockPosition",
    Callback = function(Value)
        LockPosition = Value
        local Players = game:GetService("Players")
        local RunService = game:GetService("RunService")
        local player = Players.LocalPlayer

        if LockPosition then
            -- Guardar posición actual al activar
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                OriginalPosition = char.HumanoidRootPart.Position
                Rayfield:Notify({
                    Title = "✅ Lock Position",
                    Content = "Posición bloqueada",
                    Duration = 2
                })
            else
                LockPosition = false
                Rayfield:Notify({
                    Title = "❌ Error",
                    Content = "No se pudo obtener la posición",
                    Duration = 3
                })
                return
            end

            -- Bloquear posición cada frame
            LockPositionConnection = RunService.Heartbeat:Connect(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and OriginalPosition then
                    char.HumanoidRootPart.CFrame = CFrame.new(OriginalPosition)
                end
            end)
        else
            -- Desactivar
            if LockPositionConnection then
                LockPositionConnection:Disconnect()
                LockPositionConnection = nil
            end
            OriginalPosition = nil
            Rayfield:Notify({
                Title = "🔓 Lock Position",
                Content = "Posición desbloqueada",
                Duration = 2
            })
        end
    end,
})
